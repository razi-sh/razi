{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "integer"
    },
    "product": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "subject",
    "description"
  ]
}
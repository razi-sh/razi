  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "policy_type": {
      "type": "string"
    },
    "policy_clauses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_details": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "policy_clauses",
    "claim_details"
  ]

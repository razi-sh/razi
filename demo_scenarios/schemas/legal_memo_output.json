{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "position": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": [
    "position",
    "justification",
    "evidence_ids",
    "confidence"
  ],
  "additionalProperties": false
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "remove",
        "warn",
        "no_action",
        "manual_review"
      ]
    },
    "justification": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": [
    "action",
    "justification",
    "evidence_ids",
    "confidence"
  ],
  "additionalProperties": false
}
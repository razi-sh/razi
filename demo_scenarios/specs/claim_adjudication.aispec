name: claim_adjudication
version: 1.0.0
policy: enterprise_support_v1

model:
  provider: openai
  id: gpt-4o-mini
  temperature: 0.1

input_schema: demo_scenarios/schemas/claim_adjudication_input.json
output_schema: demo_scenarios/schemas/claim_adjudication_output.json

operators:
  - type: evidence.index
    id: evidence
    fields:
      - key: policy_clauses
        source: input.policy_clauses
      - key: claim_details
        source: input.claim_details
      - key: internal_notes
        source: input.internal_notes
        governed: true

  - type: synth.json
    id: synthesis
    evidence_ref: evidence
    template: demo_scenarios/templates/claim_adjudication.txt
    max_attempts: 3
    confidence_threshold: 0.6

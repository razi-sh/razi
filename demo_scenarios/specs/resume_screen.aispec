name: resume_screen
version: 1.0.0
policy: enterprise_support_v1

model:
  provider: openai
  id: gpt-4o-mini
  temperature: 0.1

input_schema: demo_scenarios/schemas/resume_screen_input.json
output_schema: demo_scenarios/schemas/resume_screen_output.json

operators:
  - type: evidence.index
    id: evidence
    fields:
      - key: resume
        source: input.resume
      - key: requirements
        source: input.requirements
      - key: internal_notes
        source: input.internal_notes
        governed: true

  - type: synth.json
    id: synthesis
    evidence_ref: evidence
    template: demo_scenarios/templates/resume_screen.txt
    max_attempts: 3
    confidence_threshold: 0.6
